# Supabase -- from the project's API settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role key -- server-only, NEVER prefix with NEXT_PUBLIC_. Used only
# by lib/supabase/admin.ts (account creation at signup, Stripe webhook).
SUPABASE_SERVICE_ROLE_KEY=

# Stripe -- from the Stripe Dashboard. Create three recurring Prices first
# (Starter $149/mo, Growth $299/mo, Pro $499/mo) and paste their price IDs
# below (price_..., not the product ID).
STRIPE_SECRET_KEY=
# Platform account webhook endpoint -- subscription billing events only.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

# Stripe Connect -- HVAC companies collecting their own invoice payments.
# STRIPE_CONNECT_WEBHOOK_SECRET: a classic webhook endpoint with "Listen to
# events on Connected accounts" enabled, for invoice payment events
# (checkout.session.completed). Same URL as STRIPE_WEBHOOK_SECRET
# (app/api/stripe/webhook) -- Stripe signs each endpoint separately, so both
# secrets are checked there.
STRIPE_CONNECT_WEBHOOK_SECRET=
# STRIPE_CONNECT_ACCOUNT_EVENTS_SECRET: the signing secret from a v2 Event
# Destination (NOT a classic webhook endpoint -- create via the Stripe CLI or
# Dashboard, type "webhook_endpoint", event_payload "thin", pointed at
# app/api/stripe/webhook/account-events) subscribed to
# v2.core.account[requirements].updated and
# v2.core.account[configuration.merchant].capability_status_updated. Separate
# from both secrets above: account lifecycle/requirements events, not
# payments or subscriptions.
STRIPE_CONNECT_ACCOUNT_EVENTS_SECRET=

# Used to build absolute redirect URLs (Supabase email links, Stripe
# Checkout success/cancel URLs). No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
